# Firebase (required for events & location tracking)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_MUSIC_URL=optional_music_url
VITE_NTFY_URL=https://ntfy.sh/location
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Spotify playlist embed ID
VITE_SPOTIFY_PLAYLIST_ID=37i9dQZF1DX4sWSpwq3LiO

# Optional: Custom ambient audio URL
VITE_AMBIENT_AUDIO_URL=https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3

# Cloud Functions notification config (set via Firebase CLI, not in .env)
# firebase functions:config:set telegram.bot_token="..." telegram.chat_id="..."
# Or use Firebase params:
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
